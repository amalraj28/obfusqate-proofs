theorem example_generated_identity_insertion:
  (*
    """
    Purpose:
      Demonstrates the complete concrete certified identity-expansion pipeline.

    Arguments:
      None.

    Assumptions:
      The concrete basis, generated expression, prefix, and suffix have already
      been certified.

    Conclusion:
      Inserting the generated identity between the example prefix and suffix
      preserves the complete circuit up to global phase.
    """
  *)
  "phase_equiv_circuit 1
     (append_circuit_id
       (append_circuit_id
         example_identity_prefix_id
         (eval_base_compose_identity_expr
           1 basic_1q_identity_basis example_base_compose_identity_expr))
       example_identity_suffix_id)
     (append_circuit_id
       example_identity_prefix_id
       example_identity_suffix_id)"
proof -
  have generated_valid:
    "valid_quantum_circuit_id
       (eval_base_compose_identity_expr
         1 basic_1q_identity_basis example_base_compose_identity_expr)"
    using example_generated_identity_sound by simp

  have generated_identity:
    "phase_identity_circuit 1
       (eval_base_compose_identity_expr
         1 basic_1q_identity_basis example_base_compose_identity_expr)"
    using example_generated_identity_sound by simp

  have generated_n:
    "num_qubits_id
       (eval_base_compose_identity_expr
         1 basic_1q_identity_basis example_base_compose_identity_expr) = 1"
    using generated_identity
    by (simp add: phase_identity_circuit_def phase_equiv_circuit_def)

  have prefix_n:
    "num_qubits_id example_identity_prefix_id = 1"
    by (simp add:
        example_identity_prefix_id_def
        h_id_def append_gate_id_def append_instruction_id_def
        empty_circuit_id_def make_quantum_circuit_id_def)

  have suffix_n:
    "num_qubits_id example_identity_suffix_id = 1"
    by (simp add:
        example_identity_suffix_id_def
        x_id_def append_gate_id_def append_instruction_id_def
        empty_circuit_id_def make_quantum_circuit_id_def)

  show ?thesis
    using phase_identity_insertion
    apply simp
  proof -
    have f1: "obfuscation_semantics place_gate 1 (Quantum.Id 1)"
      using gate_placement_axioms obfuscation_semantics.intro by fastforce
    have "\<forall>n m f fa. executable_u3_basis_gate n m f fa = (gate n m \<and> executable_u3_basis_gate_axioms f fa)"
      using executable_u3_basis_gate_def by presburger
    then have "executable_u3_basis_gate 1 (Quantum.Id 1) denote_basis_id denote_inv_basis_id"
      using executable_u3_basis_gate_axioms by auto
    then show "phase_equiv_circuit (Suc 0) (append_circuit_id (append_circuit_id example_identity_prefix_id (eval_base_compose_identity_expr (Suc 0) basic_1q_identity_basis example_base_compose_identity_expr)) example_identity_suffix_id) (append_circuit_id example_identity_prefix_id example_identity_suffix_id)"
      using f1 by (metis (no_types) One_nat_def example_generated_identity_sound example_identity_prefix_id_valid example_identity_suffix_id_valid generated_n obfuscation_semantics_u3.intro obfuscation_semantics_u3.phase_identity_insertion prefix_n suffix_n)
  qed
qed

