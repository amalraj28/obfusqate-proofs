   eval_circuit (denote_circuit_id (empty_circuit_id 1))"
proof -
  have bridge:
    "denote_circuit_id
       (apply_step_id (empty_circuit_id 1) (InsertInverseId 0 0 [0])) =
     apply_denoted_step_id
       (empty_circuit_id 1) (InsertInverseId 0 0 [0])"
    by (rule denote_apply_step_id[OF valid_empty_circuit_id])
  have preserve:
    "eval_circuit
       (apply_denoted_step_id
         (empty_circuit_id 1) (InsertInverseId 0 0 [0])) =
     eval_circuit (denote_circuit_id (empty_circuit_id 1))"
    by (rule preserve_apply_denoted_step_id[OF valid_empty_circuit_id])
  show ?thesis
    using bridge preserve
    by (simp add: xx_identity_circuit_id_def)
qed


lemma hh_identity_circuit_id_phase_identity:
  (*
    """
    Purpose:
      Lifts exact Hadamard-pair semantics to certified phase-identity semantics.

    Arguments:
      None.

    Assumptions:
      The exact semantic equality of the Hadamard-pair circuit is available.

    Conclusion:
      The concrete Hadamard-pair circuit is an identity up to global phase.
    """
  *)
  "phase_identity_circuit 1 hh_identity_circuit_id"
proof -
  have qubits: "num_qubits_id hh_identity_circuit_id = 1"
    by (simp add:
        hh_identity_circuit_id_def
        insert_inverse_circuit_id_def
        can_insert_inverse_circuit_id_def
        can_insert_at_id_def
        valid_params_for_gate_seq_id_def
        inverses_id_def
        insert_instructions_at_id_def
        empty_circuit_id_def
        make_quantum_circuit_id_def)

  have empty_qubits: "num_qubits_id (empty_circuit_id 1) = 1"
    by (simp add:
        empty_circuit_id_def
        make_quantum_circuit_id_def)

  have equivalence:
    "equiv_upto_global_phase
       (eval_circuit (denote_circuit_id hh_identity_circuit_id))
       (eval_circuit (denote_circuit_id (empty_circuit_id 1)))"
    using hh_identity_circuit_id_semantics
    by (rule equal_matrices_are_equivalent)

  show ?thesis
    using qubits empty_qubits equivalence
    by (simp add: phase_identity_circuit_def phase_equiv_circuit_def)
qed


