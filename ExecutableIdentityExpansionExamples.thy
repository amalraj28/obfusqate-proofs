section \<open>Concrete Base and Compose Generation\<close>

fun adjoint_free_identity_expr ::
  (*
    """
    Purpose:
      Identifies the currently executable Base and Compose fragment of identity expressions.

    Arguments:
      expr:
        The identity expression being inspected.

    Assumptions:
      None.

    Conclusion:
      Returns true exactly when the expression contains no Adjoint constructor.
    """
  *)
  "identity_expr \<Rightarrow> bool"
where
  "adjoint_free_identity_expr (Base i) = True"
| "adjoint_free_identity_expr (Adjoint expr) = False"
| "adjoint_free_identity_expr (Compose left right) =
     (adjoint_free_identity_expr left \<and>
      adjoint_free_identity_expr right)"


context obfuscation_semantics_u3
begin



fun eval_base_compose_identity_expr ::
  (*
    """
    Purpose:
      Evaluates the concrete Base and Compose fragment of identity expressions.

    Arguments:
      qbit_count:
        The qubit count used by the unreachable Adjoint fallback.

      basis:
        The concrete executable identity basis.

      expr:
        The adjoint-free expression being evaluated.

    Assumptions:
      Sound use requires the expression to be adjoint-free and all base indices
      to be valid.

    Conclusion:
      Returns the executable circuit generated by base lookup and circuit composition.
    """
  *)
  "nat \<Rightarrow> quantum_circuit_id list \<Rightarrow> identity_expr \<Rightarrow>
   quantum_circuit_id"
where
  "eval_base_compose_identity_expr qbit_count basis (Base i) =
     (if i < length basis then basis ! i else empty_circuit_id qbit_count)"
| "eval_base_compose_identity_expr qbit_count basis (Adjoint expr) =
     empty_circuit_id qbit_count"
| "eval_base_compose_identity_expr qbit_count basis (Compose left right) =
     append_circuit_id
       (eval_base_compose_identity_expr qbit_count basis left)
       (eval_base_compose_identity_expr qbit_count basis right)"


theorem eval_base_compose_identity_expr_sound:
  (*
    """
    Purpose:
      Proves generator soundness for the concrete adjoint-free expression fragment.

    Arguments:
      n:
        The common number of qubits.

      basis:
        The certified executable identity basis.

      expr:
        The well-formed adjoint-free identity expression.

    Assumptions:
      The basis is valid, every base index is in bounds, and the expression uses
      only Base and Compose.

    Conclusion:
      Evaluating the expression produces a structurally valid phase identity.
    """
  *)
  assumes basis_valid: "valid_identity_basis n basis"
  assumes expr_valid: "valid_identity_expr (length basis) expr"
  assumes adjoint_free: "adjoint_free_identity_expr expr"
  shows
    "valid_quantum_circuit_id
       (eval_base_compose_identity_expr n basis expr) \<and>
     phase_identity_circuit n
       (eval_base_compose_identity_expr n basis expr)"
  using expr_valid adjoint_free
proof (induction expr)
  case (Base i)
  then have i_lt: "i < length basis" by simp
  have member:
    "valid_quantum_circuit_id (basis ! i) \<and>
     phase_identity_circuit n (basis ! i)"
    using basis_valid i_lt
    by (auto simp add: valid_identity_basis_def list_all_iff)
  show ?case
    using i_lt member by simp
next
  case (Adjoint expr)
  then show ?case by simp
next
  case (Compose left right)
  then have left:
    "valid_quantum_circuit_id
       (eval_base_compose_identity_expr n basis left) \<and>
     phase_identity_circuit n
       (eval_base_compose_identity_expr n basis left)"
    by simp
  from Compose have right:
    "valid_quantum_circuit_id
       (eval_base_compose_identity_expr n basis right) \<and>
     phase_identity_circuit n
       (eval_base_compose_identity_expr n basis right)"
    by simp
  show ?case
    by (simp add: left phase_identity_append right)
qed

end


definition example_base_compose_identity_expr ::
  (*
    """
    Purpose:
      Defines a concrete generated identity expression from both one-qubit basis members.

    Arguments:
      None.

    Assumptions:
      The concrete basis stores the Hadamard identity at index zero and the
      Pauli-X identity at index one.

    Conclusion:
      Returns an expression composing the two concrete certified base identities.
    """
  *)
  identity_expr
where
  "example_base_compose_identity_expr = Compose (Base 0) (Base 1)"


lemma example_base_compose_identity_expr_adjoint_free:
  (*
    """
    Purpose:
      Proves that the concrete example stays inside the supported expression fragment.

    Arguments:
      None.

    Assumptions:
      None.

    Conclusion:
      The example contains only Base and Compose constructors.
    """
  *)
  "adjoint_free_identity_expr example_base_compose_identity_expr"
  by (simp add: example_base_compose_identity_expr_def)


context obfuscation_semantics_u3
begin

