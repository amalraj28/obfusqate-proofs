lemma hh_identity_circuit_id_semantics:
  (*
    """
    Purpose:
      Proves exact identity semantics for the concrete Hadamard identity circuit.

    Arguments:
      None.

    Assumptions:
      Reuses the denotation bridge and semantic preservation theorem for the
      existing executable inverse-insertion step.

    Conclusion:
      The two-Hadamard circuit has exactly the same denotation as the empty
      one-qubit circuit.
    """
  *)
  "eval_circuit (denote_circuit_id hh_identity_circuit_id) =
   eval_circuit (denote_circuit_id (empty_circuit_id 1))"
proof -
  have bridge:
    "denote_circuit_id
       (apply_step_id (empty_circuit_id 1) (InsertInverseId 0 3 [0])) =
     apply_denoted_step_id
       (empty_circuit_id 1) (InsertInverseId 0 3 [0])"
    by (rule denote_apply_step_id[OF valid_empty_circuit_id])
  have preserve:
    "eval_circuit
       (apply_denoted_step_id
         (empty_circuit_id 1) (InsertInverseId 0 3 [0])) =
     eval_circuit (denote_circuit_id (empty_circuit_id 1))"
    by (rule preserve_apply_denoted_step_id[OF valid_empty_circuit_id])
  show ?thesis
    using bridge preserve
    by (simp add: hh_identity_circuit_id_def)
qed


