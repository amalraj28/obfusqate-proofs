theory ExecutableIdentityExpansionExamples
  imports ExecutableIdentityExpansion
begin

text \<open>
  A concrete reverse-and-invert executable adjoint cannot yet be instantiated
  from the current abstract placement locale. The missing semantic interface is
  a law of the intended shape

    dagger (place_gate n G params) = place_gate n (dagger G) params,

  together with a total executable inverse operation satisfying a law of the
  intended shape

    denote_gate_id (inverse_gate_id g) = dagger (denote_gate_id g).

  This theory therefore completes the concrete Base and Compose fragment and
  keeps Adjoint expressions explicitly excluded.
\<close>


section \<open>Concrete Certified Base Identities\<close>

definition hh_identity_circuit_id ::
  (*
    """
    Purpose:
      Defines a concrete one-qubit identity circuit containing two Hadamard gates.

    Arguments:
      None.

    Assumptions:
      The executable inverse table keeps the Hadamard self-inverse pair at index three.

    Conclusion:
      Returns the circuit generated by inserting the certified Hadamard inverse pair
      into an empty one-qubit circuit.
    """
  *)
  quantum_circuit_id
where
  "hh_identity_circuit_id =
     apply_step_id
       (empty_circuit_id 1)
       (InsertInverseId 0 3 [0])"


