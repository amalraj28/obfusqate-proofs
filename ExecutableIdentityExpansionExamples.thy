     (length basic_1q_identity_basis)
     example_base_compose_identity_expr"
  by (simp add:
      basic_1q_identity_basis_def
      example_base_compose_identity_expr_def)


theorem example_generated_identity_sound:
  (*
    """
    Purpose:
      Proves semantic soundness of the concrete generated identity expression.

    Arguments:
      None.

    Assumptions:
      Uses the certified one-qubit basis and the valid adjoint-free example expression.

    Conclusion:
      The generated executable circuit is structurally valid and is an identity
      up to global phase.
    """
  *)
  "valid_quantum_circuit_id
     (eval_base_compose_identity_expr
       1 basic_1q_identity_basis example_base_compose_identity_expr) \<and>
   phase_identity_circuit 1
     (eval_base_compose_identity_expr
       1 basic_1q_identity_basis example_base_compose_identity_expr)"
  using basic_1q_identity_basis_valid
        example_base_compose_identity_expr_valid
        example_base_compose_identity_expr_adjoint_free
  apply simp
  by (meson executable_u3_basis_gate_axioms executable_u3_basis_gate_def
      gate_placement_axioms id_is_gate obfuscation_semantics_def
      obfuscation_semantics_u3.eval_base_compose_identity_expr_sound
      obfuscation_semantics_u3_def)
  

